# Demo/API auth
DEMO_VIEWER_KEY=change-me
DEMO_OPERATOR_KEY=change-me

# Local data encryption (64 hex chars each)
RPM_STORAGE_KEY_HEX=
RPM_KEYSTORE_MASTER_KEY_HEX=
# Explicit demo-only bypass (not recommended)
ALLOW_DEMO_INSECURE_KEYS=0

# Optional chain indexer settings
CHAIN_RPC_URL=
VALIDATOR_MANAGER_ADDRESS=
MEASUREMENT_CONTRACT_ADDRESS=
CHAIN_SYNC_START_BLOCK=0
CHAIN_SYNC_INTERVAL_SECONDS=0
CHAIN_SYNC_MAX_BACKOFF_SECONDS=300

# API rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_WINDOW=120

# Optional: local extension hooks
CUSTOM_HOOKS_FILE=./extensions/hooks/hooks.local.js
